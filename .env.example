# строка подключения к БД; для локальной разработки подойдёт SQLite
DATABASE_URL=postgresql+asyncpg://monitor:monitor@localhost:5432/monitor
POLL_TICK_SECONDS=1
CHECK_TIMEOUT_SECONDS=3
POSTGRES_PASSWORD=
# токен API: если задан, сервер требует заголовок X-API-Token, клиенту передаётся --token
API_TOKEN=
